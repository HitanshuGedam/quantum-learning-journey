    "print(\"=\" * 60)\n",
    "print(\"EXERCISE 5 SOLUTION: Cauchy-Schwarz verification\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# The proof: |w⟩ = |u⟩ - (⟨v|u⟩/⟨v|v⟩)|v⟩\n",
    "# ⟨w|w⟩ ≥ 0 expands to give Cauchy-Schwarz\n",
    "\n",
    "# Numerical verification with random states\n",
    "np.random.seed(0)\n",
    "for trial in range(5):\n",
    "    u_vec = np.random.randn(4) + 1j * np.random.randn(4)\n",
    "    v_vec = np.random.randn(4) + 1j * np.random.randn(4)\n",
    "    u_col = u_vec.reshape(-1,1)\n",
    "    v_col = v_vec.reshape(-1,1)\n",
    "    \n",
    "    lhs = abs(inner_product(u_col, v_col))**2\n",
    "    rhs = inner_product(u_col, u_col).real * inner_product(v_col, v_col).real\n",
    "    \n",
    "    print(f\"Trial {trial+1}: |⟨u|v⟩|² = {lhs:.4f} ≤ ⟨u|u⟩⟨v|v⟩ = {rhs:.4f}  \"\n",
    "          f\"{'✓' if lhs <= rhs + 1e-10 else '✗'}\")\n",
    "\n",
