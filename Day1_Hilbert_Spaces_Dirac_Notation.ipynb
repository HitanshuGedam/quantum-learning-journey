   "source": [
    "# ── The three standard qubit bases ───────────────────────────────────────────\n",
    "\n",
    "# Z-basis\n",
    "ket_minus  = (ket0 - ket1) / np.sqrt(2)\n",
    "\n",
    "# Y-basis\n",
    "ket_yi  = (ket0 + 1j * ket1) / np.sqrt(2)   # |+i⟩ = |i⟩\n",
    "ket_myi = (ket0 - 1j * ket1) / np.sqrt(2)   # |-i⟩\n",
    "\n",
    "bases = {\n",
    "    \"Z\": ([ket0,    ket1   ], [\"|0⟩\",  \"|1⟩\" ]),\n",
    "    \"X\": ([ket_plus,ket_minus],  [\"| +⟩\", \"| -⟩\"]),\n",
    "    \"Y\": ([ket_yi,  ket_myi],  [\"| i⟩\", \"|-i⟩\"]),\n",
    "}\n",
    "\n",
    "print(\"=== Orthonormality of standard qubit bases ===\")\n",
    "for name, (vecs, labels) in bases.items():\n",
    "    v0, v1 = vecs\n",
    "    l0, l1 = labels\n",
    "    print(f\"\\n{name}-basis:\")\n",
    "    print(f\"  ⟨{l0}|{l0}⟩ = {inner_product(v0,v0):.4f}\")\n",
    "    print(f\"  ⟨{l1}|{l1}⟩ = {inner_product(v1,v1):.4f}\")\n",
    "    print(f\"  ⟨{l0}|{l1}⟩ = {inner_product(v0,v1):.4f}\")"
   ]
