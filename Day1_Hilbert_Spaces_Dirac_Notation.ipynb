    "# ── Outer products ────────────────────────────────────────────────────────────\n",
    "\n",
    "def outer(u, v):\n",
    "    \"\"\"Compute the outer product |u⟩⟨v| = u @ v†\"\"\"\n",
    "    return u @ bra(v)\n",
    "\n",
    "# Projector onto |0⟩\n",
    "P0 = outer(ket0, ket0)   # |0⟩⟨0|\n",
    "P1 = outer(ket1, ket1)   # |1⟩⟨1|\n",
    "\n",
    "print(\"=== Projector P0 = |0⟩⟨0| ===\")\n",
    "print(P0)\n",
    "\n",
    "print()\n",
    "print(\"=== Projector P1 = |1⟩⟨1| ===\")\n",
    "print(P1)\n",
    "\n",
    "print()\n",
    "print(\"=== Completeness relation: P0 + P1 = I ===\")\n",
    "identity_check = P0 + P1\n",
    "print(identity_check)\n",
    "print(\"Is identity?\", np.allclose(identity_check, np.eye(2)))\n",
    "\n",
    "print()\n",
    "print(\"=== Idempotency: P0² = P0 ===\")\n",
    "print(\"P0 @ P0 =\")\n",
    "print(P0 @ P0)\n",
    "print(\"Equal to P0?\", np.allclose(P0 @ P0, P0))\n",
    "\n",
    "print()\n",
    "print(\"=== Extracting component: P0|+⟩ = ⟨0|+⟩|0⟩ ===\")\n",
    "result = P0 @ ket_plus\n",
    "print(\"P0|+⟩ =\", result.flatten())\n",
    "print(\"Expected ⟨0|+⟩|0⟩ = (1/√2)|0⟩ =\", (ket0/np.sqrt(2)).flatten())"
   ]
