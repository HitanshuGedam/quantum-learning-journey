   "cell_type": "code",
   "execution_count": null,
   "id": "spectral-decomp",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Spectral decomposition of Z ───────────────────────────────────────────────\n",
    "\n",
    "eigvals, eigvecs = np.linalg.eigh(Z)   # eigh for Hermitian matrices\n",
    "\n",
    "print(\"=== Spectral decomposition of Z = σz ===\")\n",
    "print(f\"Eigenvalues: {eigvals}\")\n",
    "print()\n",
    "\n",
    "Z_reconstructed = np.zeros((2,2), dtype=complex)\n",
    "for lam, evec in zip(eigvals, eigvecs.T):   # eigvecs.T gives eigenvectors as rows\n",
    "    e = evec.reshape(-1,1)   # make it a column vector\n",
    "    proj = outer(e, e)\n",
    "    Z_reconstructed += lam * proj\n",
    "    print(f\"λ={lam:+.1f}, eigenvector={evec}, projector:\")\n",
    "    print(proj)\n",
    "    print()\n",
    "\n",
    "print(\"Reconstructed Z = Σ λi|ei⟩⟨ei|:\")\n",
    "print(Z_reconstructed.real)\n",
    "print(\"Matches Z?\", np.allclose(Z_reconstructed, Z))\n",
    "\n",
    "print()\n",
    "print(\"=== Function of operator: exp(iπZ/2) ===\")\n",
    "# exp(iπZ/2) = Σ exp(iπλi/2)|ei⟩⟨ei|\n",
    "theta = np.pi/2\n",
    "exp_Z = np.zeros((2,2), dtype=complex)\n",
    "for lam, evec in zip(eigvals, eigvecs.T):\n",
    "    e = evec.reshape(-1,1)\n",
    "    exp_Z += np.exp(1j * theta * lam) * outer(e, e)\n",
    "\n",
    "print(\"exp(iπZ/2) =\")\n",
    "print(np.round(exp_Z, 4))\n",
    "print(\"This equals the S gate (up to global phase)\")"
   ]
